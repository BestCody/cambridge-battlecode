.cambc/
bots/*/.cambc/
matches/
replays/
bots/*/build/
bots/*/target/
notes
.vscode

# print dont int: full replays, extracted data and 600-round checkpoints (4.4 GB unpacked)
/print_dont_int*.zip
playground.txt

# Local replays and detailed statistics from the 140-game all-map evaluation.
/analysis/baseline-vs-test-all-maps-140/*.repl26a
/analysis/baseline-vs-test-all-maps-140/current-*.json
/analysis/baseline-vs-test-all-maps-140/manifest-*.txt

# Local replays and detailed statistics from the current 140-game all-map run.
/analysis/baseline-vs-test-all-maps-140-current/*.repl26a
/analysis/baseline-vs-test-all-maps-140-current/current-*.json
/analysis/baseline-vs-test-all-maps-140-current/manifest-*.txt

# Local A/B evaluation replays and detailed match statistics.
/analysis/*-ab-all-maps-140/*.repl26a
/analysis/*-ab-all-maps-140/*.json
!/analysis/*-ab-all-maps-140/games.json
/analysis/*-ab-all-maps-140/manifest-*.txt

# Local map probes: retain summaries and the compact game index.
/analysis/*-probe-*/*.repl26a
/analysis/*-probe-*/*.json
!/analysis/*-probe-*/games.json
/analysis/*-probe-*/manifest-*.txt

# Local replays and detailed statistics from the 4-million-fuel all-map evaluation.
/analysis/baseline-vs-test-all-maps-140-fuel4m/*.repl26a
/analysis/baseline-vs-test-all-maps-140-fuel4m/current-*.json
/analysis/baseline-vs-test-all-maps-140-fuel4m/manifest-*.txt

# Local match replays and detailed statistics from Prism banking evaluations.
/analysis/baseline-vs-test-80-prism-*/*.repl26a
/analysis/baseline-vs-test-80-prism-*/current-*.json
/analysis/baseline-vs-test-80-prism-*/manifest-*.txt

# Local replays and detailed statistics from the controlled Prism A/B test.
/analysis/prism-banking-ab-*/*.repl26a
/analysis/prism-banking-ab-*/ab_fixed-*.json
/analysis/prism-banking-ab-*/ab_dynamic-*.json
/analysis/prism-banking-ab-*/manifest-*.txt
ga_runs/
__pycache__/
compile_commands.json

# Scratch replays, downloaded match summaries and ladder dumps from single-game study.
/analysis/**/*.repl26a
/analysis/**/summ/
/analysis/**/summary.json
/analysis/**/*_replay
/analysis/**/*.err
/analysis/*.json
/analysis/*.id
/analysis/*.log
/analysis/*_show.json
/analysis/**/*.zip
/analysis/ifish/
/analysis/linked/
/analysis/me4/
/analysis/pg[0-9]/
/analysis/t1/

# Single-game study (2026-11-02): local evaluate.py batches (analysis/<name>/ with replays, per-game
# JSON and games.json), downloaded practice games (analysis/pg10/<game>/) and the per-map feature
# dumps (regenerated by analysis/mapfeat/features.py) stay local. Scripts, opponent lists and the
# per-version practice results are kept.
/analysis/*
!/analysis/*.md
!/analysis/*.py
!/analysis/*.csv
!/analysis/mapfeat/
/analysis/mapfeat/*
!/analysis/mapfeat/*.py
!/analysis/pg10/
/analysis/pg10/*
!/analysis/pg10/*.sh
!/analysis/pg10/*.py
!/analysis/pg10/*.txt
/bots/stacker/

# Debug-mode copy of the bot (cambc build without --release: debug_block prints, fuel paused inside them).
/bots/_dbg/
